post_install() {
    echo "==> vkturn installed (daemon + GUI)"
    echo ""
    echo "Binaries:"
    echo "  /usr/bin/vkturnd     - daemon"
    echo "  /usr/bin/vkturnctl   - CLI"
    echo "  /usr/bin/vkturn-gui  - GUI (desktop app)"
    echo ""
    echo "To use without password prompts:"
    echo "  sudo usermod -a -G vkturn \$USER"
    echo "  newgrp vkturn"
    echo ""
    echo "To start the daemon:"
    echo "  sudo systemctl enable --now vkturnd"
    echo ""
    echo "To launch GUI:"
    echo "  vkturn-gui"
    echo ""
    echo "CLI available as: vkturnctl"
    echo "  vkturnctl -op=status"
    echo "  sudo vkturnctl -op=up -id=test -config=/etc/vkturn/example.json"
}

post_upgrade() {
    post_install "$@"
}

pre_remove() {
    systemctl disable --now vkturnd 2>/dev/null || true
}
